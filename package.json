{
  "name": "whatsapp-mcp",
  "version": "0.1.0",
  "description": "MCP server that links to a personal WhatsApp account as a companion device (QR / pairing code) via Baileys.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "whatsapp-mcp": "dist/src/index.js",
    "whatsapp-mcp-stdio": "dist/bin/stdio-shim.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "patch-package": "8.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
