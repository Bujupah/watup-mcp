# whatsapp-mcp configuration. Copy to .env (never commit it) or set these in your process manager.

# --- Required -----------------------------------------------------------------

# Bearer token clients must send on /mcp (Authorization: Bearer <token>). At least 16 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WA_MCP_TOKEN=

# 32-byte key, base64. Encrypts the WhatsApp session (auth state) at rest with AES-256-GCM.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in a secret store, NOT next to the database. Losing it means re-linking the device.
WA_MCP_MASTER_KEY=

# --- Network ------------------------------------------------------------------

# Port for /mcp, /qr, /qr/events and /health.
WA_MCP_PORT=8787

# Bind address. Anything other than loopback requires WA_MCP_ALLOW_REMOTE=true.
WA_MCP_HOST=127.0.0.1

# Allow binding to a non-loopback address. Only do this behind a TLS reverse proxy.
WA_MCP_ALLOW_REMOTE=false

# Public base URL (e.g. https://whatsapp-mcp.onrender.com) used for links like the QR page.
# Defaults to RENDER_EXTERNAL_URL on Render, otherwise http://<host>:<port>. PORT is honoured if WA_MCP_PORT is unset.
WA_MCP_PUBLIC_URL=

# Also accept the token as a URL path segment (POST /mcp/<token>) for clients that can't send headers,
# such as claude.ai custom connectors. The URL then becomes the secret.
WA_MCP_ALLOW_URL_TOKEN=false

# --- WhatsApp credentials in Postgres (optional) ------------------------------------
# Keep the WhatsApp link across restarts on hosts without a persistent disk (e.g. Render free).
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4).
# Values are encrypted with WA_MCP_MASTER_KEY before they are stored. The cache stays in SQLite.
WA_MCP_AUTH_DATABASE_URL=
# Optional PEM CA certificate to verify the database's TLS certificate (Supabase: Download certificate).
WA_MCP_AUTH_DATABASE_CA=

# --- Storage ------------------------------------------------------------------

# SQLite database (credentials + cache + audit log). Directory is created 0700, file 0600.
WA_MCP_DB_PATH=~/.whatsapp-mcp/data.db

# Ask the phone for the full message history on first link (slower, larger DB).
WA_MCP_SYNC_FULL_HISTORY=false

# Log level for Baileys' internal logger. Set to info/debug to diagnose linking problems.
WA_MCP_BAILEYS_LOG_LEVEL=warn

# --- ElevenLabs (optional) --------------------------------------------------------

# Enables ElevenLabs features. Keep it secret; set it in your host's environment, never in git.
ELEVENLABS_API_KEY=

# Voice for spoken output (default: Salim, Tunisian Arabic).
WA_MCP_TTS_VOICE_ID=nH7M8bGCLQbKoS0wBZj7

# Phone calls (prepare_call / confirm_call / get_call) need all three of:
# ELEVENLABS_API_KEY, the ElevenLabs agent that talks, and the ElevenLabs id of a phone number
# imported into that workspace (Twilio or SIP trunk).
WA_MCP_CALL_AGENT_ID=
WA_MCP_CALL_PHONE_NUMBER_ID=
# twilio | sip_trunk
WA_MCP_CALL_PROVIDER=twilio

# --- Guardrails ---------------------------------------------------------------

# Two-step send (prepare_message -> confirm_send). Set false to expose a one-step send_message tool.
WA_MCP_REQUIRE_CONFIRM=true

# Comma-separated phone numbers (with country code) and/or JIDs the agent may message.
# Empty = anyone (a warning is logged at startup). Example: +14155550123,120363012345678901@g.us
WA_MCP_ALLOWLIST=

# Max messages sent per minute (token bucket).
WA_MCP_RATE_PER_MIN=10

# Max distinct never-messaged recipients per rolling 24 hours.
WA_MCP_NEW_CONTACTS_PER_DAY=20

# --- Logging ------------------------------------------------------------------

# trace | debug | info | warn | error | fatal | silent. Message content is only logged at debug/trace.
WA_MCP_LOG_LEVEL=info
